# Google Cloud Project Configuration
GCP_PROJECT_ID=the-cafe-companion
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration (SQLite default for local, PostgreSQL for Cloud SQL)
DATABASE_URL=sqlite:///./cafe.db
# Cloud SQL example: postgresql+psycopg2://user:password@/dbname?host=/cloudsql/project:region:instance

# Server Port
PORT=8080
HOST=0.0.0.0
